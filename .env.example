# Copy to .env.testing (gitignored) for local integration testing.
# Never commit real values.

# Microsoft Entra tenant (directory) ID - GUID
TENANT_ID=

# App registration (client) ID - GUID
CLIENT_ID=

# App registration client secret value
CLIENT_SECRET=

# Dataverse environment URL, e.g. https://orgxxxxx.crm.dynamics.com
DATAVERSE_URL=

# Human-readable label used only in local logs
TEST_ENVIRONMENT_NAME=
